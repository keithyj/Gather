# Supabase project values. The anon key is intentionally public; never put a service-role key in this project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, random 32-byte key encoded as base64. Required before real sensitive details can be created.
EVENT_DETAILS_ENCRYPTION_KEY=
# Optional local development override used for magic-link redirects.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
