# Supabase project values. The publishable key is intentionally public. The legacy anon name is also accepted
# for local CLI versions that still print it; set only one of the two key names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required only to resolve a username to an email during password sign-in; never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only, random 32-byte key encoded as base64. Required before real sensitive details can be created.
EVENT_DETAILS_ENCRYPTION_KEY=
# Public canonical URL used only for Supabase email-confirmation redirects initiated on the server.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
